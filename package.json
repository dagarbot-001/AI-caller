  "description": "Open-source AI Voice Sales Agent with Asterisk, Whisper STT, OpenAI reasoning, and Piper/Coqui TTS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "echo \"No lint configured yet\"",
